generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  THERAPIST
  ADMIN
}

enum NoteVisibility {
  PRIVATE
  SHARED
  HOMEWORK
}

model User {
  id                  String   @id @default(uuid())
  phone               String?  @unique
  googleId            String?  @unique
  avatarUrl           String?
  email               String?
  name                String?
  goal                String?
  passwordHash        String?
  resetTokenHash      String?
  resetTokenExpiresAt DateTime?
  resetTokenSentAt    DateTime?
  referralCode        String?  @unique
  referredByCode      String?
  onboardingComplete  Boolean  @default(false)
  isAdmin             Boolean  @default(false)
  role                Role     @default(CLIENT)
  policySignedAt      DateTime?
  policySignedName    String?
  bookings            Booking[]
  payments            Payment[]
  reviews             Review[]
  userPackages        UserPackage[]
  subscriptions       Subscription[]
  referralsMade       Referral[] @relation("Referrer")
  referralsReceived   Referral[] @relation("Referee")
  promoUsages         PromoUsage[]
  adminActions        AdminAuditLog[] @relation("AdminActor")
  auditTargets        AdminAuditLog[] @relation("AdminTarget")
  therapistProfile    TherapistProfile?
  clientProfile       ClientProfile?
  therapistNotes      TherapyNote[] @relation("TherapistNotes")
  clientNotes         TherapyNote[] @relation("ClientNotes")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model TherapistProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  bio             String?
  specializations String[]
  qualifications  String?
  licenseNumber   String?
  profileImageUrl String?
  isActive        Boolean  @default(true)
  sessions        Session[]
  zoomConfig      ZoomConfig?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ClientProfile {
  id               String    @id @default(uuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id])
  emergencyContact String?
  emergencyPhone   String?
  therapyGoals     String?
  intakeNotes      String?
  dateOfBirth      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AdminAuditLog {
  id           String   @id @default(uuid())
  adminUserId  String
  targetUserId String?
  action       String
  metadata     Json?
  createdAt    DateTime @default(now())
  adminUser    User     @relation("AdminActor", fields: [adminUserId], references: [id])
  targetUser   User?    @relation("AdminTarget", fields: [targetUserId], references: [id])
}

model Session {
  id           String            @id @default(uuid())
  title        String
  host         String
  startTime    DateTime
  price        Int
  currency     String
  tidycalUrl   String?
  therapistId  String?
  therapist    TherapistProfile? @relation(fields: [therapistId], references: [id])
  bookings     Booking[]
  reviews      Review[]
  createdAt    DateTime          @default(now())
}

model Booking {
  id               String       @id @default(uuid())
  userId           String
  sessionId        String
  status           String
  amount           Int
  currency         String
  razorpayOrderId  String?
  paidAt           DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  reminder24hSent  Boolean      @default(false)
  reminder1hSent   Boolean      @default(false)
  promoCodeId      String?
  promoDiscount    Int          @default(0)
  referralDiscount Int          @default(0)
  usedCredit       Boolean      @default(false)
  policySignedName String?
  policySignature  String?
  policyAgreedAt   DateTime?
  user             User         @relation(fields: [userId], references: [id])
  session          Session      @relation(fields: [sessionId], references: [id])
  payment          Payment?
  review           Review?
  creditUsage      CreditUsage?
  therapyNote      TherapyNote?
  zoomMeeting      ZoomMeeting?
  tidycalBookingId Int?         @unique
  meetingUrl       String?
  actualStartTime  DateTime?
  actualEndTime    DateTime?
  tidycalSyncedAt  DateTime?
  createdAt        DateTime     @default(now())
}

model Payment {
  id                String   @id @default(uuid())
  bookingId         String   @unique
  userId            String
  razorpayPaymentId String   @unique
  razorpayOrderId   String
  status            String
  booking           Booking  @relation(fields: [bookingId], references: [id])
  user              User     @relation(fields: [userId], references: [id])
  createdAt         DateTime @default(now())
}

model Review {
  id        String   @id @default(uuid())
  bookingId String   @unique
  userId    String
  sessionId String
  rating    Int
  comment   String?
  booking   Booking  @relation(fields: [bookingId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  session   Session  @relation(fields: [sessionId], references: [id])
  createdAt DateTime @default(now())
}

model TherapyNote {
  id               String         @id @default(uuid())
  bookingId        String         @unique
  booking          Booking        @relation(fields: [bookingId], references: [id])
  therapistId      String
  therapist        User           @relation("TherapistNotes", fields: [therapistId], references: [id])
  clientId         String
  client           User           @relation("ClientNotes", fields: [clientId], references: [id])
  sessionSummary   String?
  keyThemes        String[]
  emotionalState   String?
  moodRating       Int?
  observations     String?
  interventions    String?
  actionItems      String?
  nextSessionFocus String?
  internalNotes    String?
  visibility       NoteVisibility @default(PRIVATE)
  sharedAt         DateTime?
  attachments      NoteAttachment[]
  tags             NoteTag[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model NoteAttachment {
  id            String      @id @default(uuid())
  noteId        String
  note          TherapyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  fileName      String
  fileUrl       String
  fileType      String
  fileSizeBytes Int
  createdAt     DateTime    @default(now())
}

model NoteTag {
  id       String      @id @default(uuid())
  noteId   String
  note     TherapyNote @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag      String
  category String

  @@index([tag])
  @@index([category])
}

model Package {
  id           String        @id @default(uuid())
  name         String
  sessionCount Int
  price        Int
  currency     String        @default("INR")
  description  String?
  active       Boolean       @default(true)
  userPackages UserPackage[]
  createdAt    DateTime      @default(now())
}

model UserPackage {
  id              String        @id @default(uuid())
  userId          String
  packageId       String
  creditsTotal    Int
  creditsUsed     Int           @default(0)
  razorpayOrderId String?
  status          String
  paidAt          DateTime?
  user            User          @relation(fields: [userId], references: [id])
  package         Package       @relation(fields: [packageId], references: [id])
  creditUsages    CreditUsage[]
  createdAt       DateTime      @default(now())
}

model CreditUsage {
  id            String      @id @default(uuid())
  userPackageId String
  bookingId     String      @unique
  userPackage   UserPackage @relation(fields: [userPackageId], references: [id])
  booking       Booking     @relation(fields: [bookingId], references: [id])
  createdAt     DateTime    @default(now())
}

model Subscription {
  id            String   @id @default(uuid())
  userId        String
  sessionTitle  String
  frequency     String
  price         Int
  currency      String   @default("INR")
  status        String
  nextBillingAt DateTime
  user          User     @relation(fields: [userId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Referral {
  id           String   @id @default(uuid())
  referrerId   String
  refereeId    String
  status       String
  discountPct  Int      @default(10)
  referrerUsed Boolean  @default(false)
  refereeUsed  Boolean  @default(false)
  referrer     User     @relation("Referrer", fields: [referrerId], references: [id])
  referee      User     @relation("Referee", fields: [refereeId], references: [id])
  createdAt    DateTime @default(now())
}

model PromoCode {
  id          String       @id @default(uuid())
  code        String       @unique
  type        String
  value       Int
  maxUses     Int?
  usedCount   Int          @default(0)
  minAmount   Int?
  active      Boolean      @default(true)
  expiresAt   DateTime?
  promoUsages PromoUsage[]
  createdAt   DateTime     @default(now())
}

model PromoUsage {
  id          String    @id @default(uuid())
  promoCodeId String
  userId      String
  bookingId   String?
  discount    Int
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  createdAt   DateTime  @default(now())
}

// ─── Zoom Integration ─────────────────────────────────────────────────────────

model ZoomConfig {
  id            String            @id @default(uuid())
  accountId     String            @unique
  clientId      String
  clientSecret  String
  accessToken   String?
  tokenExpiry   DateTime?
  therapistId   String?           @unique
  therapist     TherapistProfile? @relation(fields: [therapistId], references: [id])
  isDefault     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ZoomMeeting {
  id            String          @id @default(uuid())
  zoomMeetingId String          @unique
  bookingId     String          @unique
  booking       Booking         @relation(fields: [bookingId], references: [id])
  joinUrl       String
  startUrl      String
  password      String?
  status        String          @default("scheduled")
  recordings    ZoomRecording[]
  createdAt     DateTime        @default(now())
}

model ZoomRecording {
  id             String      @id @default(uuid())
  zoomMeetingId  String
  meeting        ZoomMeeting @relation(fields: [zoomMeetingId], references: [id])
  recordingId    String      @unique
  recordingType  String
  fileType       String
  fileSize       Int?
  downloadUrl    String?
  localPath      String?
  transcriptText String?
  status         String      @default("processing")
  createdAt      DateTime    @default(now())
}

// ─── Public marketing shop (Razorpay checkout) ───────────────────────────────

model ShopProduct {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  priceInr    Int
  stock       Int?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orderItems  ShopOrderItem[]
}

model ShopOrder {
  id                String   @id @default(uuid())
  customerEmail     String?
  customerName      String?
  customerPhone     String?
  status            String   @default("pending")
  amountInr         Int
  currency          String   @default("INR")
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  items             ShopOrderItem[]
}

model ShopOrderItem {
  id           String      @id @default(uuid())
  orderId      String
  order        ShopOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      ShopProduct @relation(fields: [productId], references: [id])
  quantity     Int
  unitPriceInr Int
  createdAt    DateTime    @default(now())
}
